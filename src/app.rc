#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "version.h"

1 24 "app.manifest"

IDI_APP ICON "../assets/OpenChatMix.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Swiftlyx"
            VALUE "FileDescription", "OpenChatMix"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "OpenChatMix"
            VALUE "LegalCopyright", "Copyright (c) 2026 Swiftlyx. MIT License."
            VALUE "OriginalFilename", "OpenChatMix.exe"
            VALUE "ProductName", "OpenChatMix"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
