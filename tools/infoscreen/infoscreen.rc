#pragma code_page(65001)

#include <windows.h>
#include "../../src/version.h"

1 ICON "../../assets/OpenChatMix.ico"

// The settings OpenChatMix's panel shows for this add-on; the program reads its defaults from here too.
OPENCHATMIX_OPTIONS RCDATA "options.json"

// Signed PawnIO modules from PawnIO.Modules 0.2.11 (LGPL-2.1); see pawnio/README.md.
PAWNIO_AMDFAMILY17 RCDATA "pawnio/AMDFamily17.bin"
PAWNIO_INTELMSR RCDATA "pawnio/IntelMSR.bin"
PAWNIO_LPCIO RCDATA "pawnio/LpcIO.bin"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Swiftlyx"
            VALUE "FileDescription", "OpenChatMix Info Screen"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "OpenChatMix-InfoScreen"
            VALUE "LegalCopyright", "Copyright (c) 2026 Swiftlyx. MIT License."
            VALUE "OriginalFilename", "OpenChatMix-InfoScreen.exe"
            VALUE "ProductName", "OpenChatMix"
            VALUE "ProductVersion", APP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
